/delete-node/ &reserved_partition_0;
/delete-node/ &code_partition;
/delete-node/ &storage_partition;
/delete-node/ &boot_partition;
#include <nordic/nrf52840_partition_uf2_sdv7.dtsi>
#include <zephyr/dt-bindings/battery/battery.h>


/ {

    aliases {
        fuel-gauge0 = &fuel_gauge;
    };

	vcc_3v3: vcc_3v3 {
		compatible = "regulator-fixed";

		regulator-name = "reg-vcc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
        // Should be ACTIVE_HIGH but https://github.com/zephyrproject-rtos/zephyr/pull/89973 not in nrf-sdk yet
		enable-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;

		regulator-boot-on;
		status = "okay";
	};

	vbatt: vbatt {
		compatible = "voltage-divider";
		io-channels = <&adc 0>;
		// Multiply by 5 as we use NRF_SAADC_VDDHDIV5
        output-ohms = <250>;
        full-ohms = <(1000+250)>;
	};

	fuel_gauge: fuel_gauge {
		compatible = "zephyr,fuel-gauge-composite";
		battery-voltage = <&vbatt>;
		device-chemistry = "lithium-ion-polymer";
		ocv-capacity-table-0 = <BATTERY_OCV_CURVE_LITHIUM_ION_POLYMER_DEFAULT>;
		charge-full-design-microamp-hours = <200000>;
	};
};

&adc {
    #address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
        // Channel used for vbatt
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_2";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_VDDHDIV5>;
		zephyr,resolution = <14>;
		zephyr,oversampling = <4>;
	};

	status = "okay";
};

&uart1 {
    status = "disabled";
};

&uart0 {
    status = "disabled";
};

&gpio1 {
    status = "disabled";
};

&i2c0 {
    status = "disabled";
};

&i2c1 {
    status = "disabled";
};

&spi2 {
    status = "disabled";
};

&pwm0 {
	status = "disabled";
};

&ieee802154 {
    status = "disabled";
};
