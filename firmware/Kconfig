mainmenu "FruityTag"

# Your application configuration options go here

config NRF52_ADAFRUIT_BOOTLOADER
	bool "Enable flashing through adafruit-nrfutil"
	depends on SOC_SERIES_NRF52X
	default y if (!BOARD_HAS_NRF5_BOOTLOADER && BUILD_OUTPUT_UF2)
	help
	    Device must use Adafruit nRF52 Bootloader as a bootloader

config FRUITYTAG_ADVERTISEMENT_INTERVAL
    int "Advertisement interval"
    range 1 10000
    default 2000
    help
        The interval between advertisements in ms

rsource "src/fruitytag/Kconfig"
rsource "src/keystore/Kconfig"

source "Kconfig.zephyr"
